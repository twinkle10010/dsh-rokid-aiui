{
  "name": "dsh-rokid-aiui",
  "version": "0.3.0",
  "description": "DeepSeek Harness Rokid AIUI dev suite: one bundle that installs the AIUI dev console (live aix preview with hot-reload, project tree, fenced project API), the \"AIUI 开发模式\" agent preset as a declaration row, and the vendored aiui-dev / aiui-cloud-integration skills.",
  "type": "module",
  "main": "lib/aiui-dev-console.js",
  "exports": {
    ".": "./lib/aiui-dev-console.js"
  },
  "files": [
    "lib",
    "src",
    "client",
    "preset",
    "build.mjs",
    "cordis.patch.yml",
    "preset.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset.patch.yml"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinkle10010/dsh-rokid-aiui.git"
  },
  "homepage": "https://github.com/twinkle10010/dsh-rokid-aiui#readme",
  "bugs": {
    "url": "https://github.com/twinkle10010/dsh-rokid-aiui/issues"
  },
  "author": "shanlishuo <347841284@qq.com>",
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "@yodaos-pkg/aix-cli": "^0.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "aiui",
    "aix",
    "preview"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
